     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			gst_number
			(
    			type = text
				displayname = "GST Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			vendor_rating
			(
				type = picklist
				displayname = "Vendor Rating"
				values = {"Excellent","Poor","Average","Good"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list asset_Report
		{
			displayName = "All Assets"
			show all rows from asset    
			(
				asset_id as "Asset ID"
				asset_name as "Asset Name"
				category as "Category"
				serial_number as "Serial Number"
				vendor as "Vendor"
				location as "Location"
				purchase_date as "Purchase Date"
				purchase_cost as "Purchase Cost"
				(
					display = total,average,min,max	
				)
				warranty_expiry as "Warranty Expiry"
				asset_condition as "Asset Condition"
				asset_status as "Asset Status"
				asset_tag as "Asset Tag"
				remarks as "Remarks"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (asset_condition == "Excellent")
				fields = [asset_condition]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (asset_condition == "Fair")
				fields = [asset_condition]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (asset_condition == "Good")
				fields = [asset_condition]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (asset_condition == "Poor")
				fields = [asset_condition]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
