 application "Asset Lifecycle Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form asset
		{
			displayname = "Asset"
			success message = "Asset Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			asset_id
			(
    			type = autonumber
				displayname = "Asset ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset_name
			(
    			type = text
				displayname = "Asset Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = list	
				displayname = "Category"
				values  = asset_category.ID
    			displayformat = [category_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			serial_number
			(
    			type = text
				displayname = "Serial Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			vendor
			(
				type = list	
				displayname = "Vendor"
				values  = vendor.ID
    			displayformat = [vendor_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
				type = picklist
				displayname = "Location"
				values = {"Thermal Lab","Materials Testing Lab","Metrology Lab","Machine Shop","CAD-CAM Lab","Welding Shop"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			purchase_date
			(
    			type = date
				displayname = "Purchase Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			purchase_cost
			(
				displayname = "Purchase Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			warranty_expiry
			(
    			type = date
				displayname = "Warranty Expiry"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset_condition
			(
				type = picklist
				displayname = "Asset Condition"
				values = {"Excellent","Poor","Fair","Good"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset_status
			(
				type = picklist
				displayname = "Asset Status"
				values = {"In Use","Under Maintenance","In Stock","Disposed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset_tag
			(
    			type = text
				displayname = "Asset Tag"
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
