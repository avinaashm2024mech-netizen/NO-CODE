		workflow
		{

		schedule
		{
			notify_technician_upcoming_maintenance as "Notify Technician for Upcoming Maintenance"
			{
				type =  schedule
				form = maintenance_schedule
					status = inactive
				start = next_due_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Get the next due date from the input maintenance schedule record
										nextDueDate = input.next_due_date;
										// Calculate the date one week from now
										oneWeekFromNow = nextDueDate.addDay(7);
										// Calculate the date one week before the next due date
										oneWeekBeforeDue = nextDueDate.addDay(-7);
										// Check if the next due date is within the next week (between today and one week from now)
										if(today >= oneWeekBeforeDue && today <= oneWeekFromNow)
										{
											// Get the assigned technician's email
											technicianEmail = input.assigned_technician;
											// Get the maintenance type
											maintenanceType = input.maintenance_type;
											// Get the asset name (accessing through multi_select_lookup)
											assetName = "";
											if(!input.asset.isNull())
											{
												for each  assetRecord in input.asset
												{
													assetName = assetRecord.asset_name;
													break;
												}
											}
											// Get the schedule ID
											scheduleId = input.schedule_id;
											// Send email to the technician
											sendmail
											[
												from :zoho.loginuserid
												to :technicianEmail
												subject :"Maintenance Due Soon - Schedule ID: " + scheduleId.toString()
												message :"Dear Technician,\n\nThis is a reminder that the following maintenance is due next week:\n\nSchedule ID: " + scheduleId.toString() + "\nMaintenance Type: " + maintenanceType + "\nAsset: " + assetName + "\nDue Date: " + nextDueDate.toString() + "\n\nPlease prepare accordingly.\n\nBest regards,\nAsset Management System"
											]
										}
					)
					}
				}
			}
		}




